<div class="col-md-3 mb-4">
  <div class="card h-100 shadow-sm">
  <% if product.image.attached? %>
  <%= image_tag product.image.variant(resize_to_limit: [400, 260]), class: "card-img-top object-fit-cover", style: "height: 180px;", alt: product.title %>
<% end %>
    <div class="card-body d-flex flex-column">
      <span class="badge bg-secondary mb-2 align-self-start"><%= product.category.name %></span>
      <h5 class="card-title">
        <%= link_to product.title, product_path(product), class: "text-decoration-none text-dark" %>
      </h5>
      <p class="card-text text-muted small flex-grow-1"><%= truncate(product.description, length: 90) %></p>
      <p class="fw-bold fs-5 mb-1"><%= number_to_currency(product.price) %></p>
      <p class="text-muted small mb-2">In Stock: <%= product.stock_quantity %></p>
      <div class="d-flex gap-2">
        <%= link_to "View Details", product_path(product), class: "btn btn-sm btn-outline-primary" %>
        <%= button_to "Add to Cart", add_to_cart_path(product), method: :post, class: "btn btn-sm btn-success" %>
      </div>
    </div>
  </div>
</div>
