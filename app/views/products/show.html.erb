<div class="card p-4 shadow-sm">
  <span class="badge bg-secondary mb-2 align-self-start"><%= @product.category.name %></span>
  <h1 class="mb-3"><%= @product.title %></h1>
  <p class="lead"><%= @product.description %></p>
  <hr>
  <h3 class="text-success mb-2"><%= number_to_currency(@product.price) %></h3>
  <p class="mb-4">Available Stock: <strong><%= @product.stock_quantity %> units</strong></p>

  <div class="d-flex gap-2">
    <%= button_to "Add to Cart", add_to_cart_path(@product), method: :post, class: "btn btn-success btn-lg" %>
    <%= link_to "Back to All Products", root_path, class: "btn btn-outline-secondary btn-lg" %>
  </div>
</div>
