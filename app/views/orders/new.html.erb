<h1 class="mb-4">Checkout</h1>

<% if @customer.errors.any? %>
  <div class="alert alert-danger">
    <h5>Please fix the following errors:</h5>
    <ul class="mb-0">
      <% @customer.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row">
  <div class="col-md-7">
    <div class="card p-4 shadow-sm mb-4">
      <h4 class="mb-3">Customer & Shipping Address</h4>
      <%= form_with model: @customer, url: orders_path, local: true do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :first_name, class: "form-label" %>
            <%= f.text_field :first_name, class: "form-control", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name, class: "form-control", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :phone, class: "form-label" %>
            <%= f.text_field :phone, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :street_address, class: "form-label" %>
            <%= f.text_field :street_address, class: "form-control", required: true %>
          </div>
          <div class="col-md-5">
            <%= f.label :city, class: "form-label" %>
            <%= f.text_field :city, class: "form-control", required: true %>
          </div>
          <div class="col-md-4">
            <%= f.label :province_id, "Province / Territory", class: "form-label" %>
            <%= f.collection_select :province_id, @provinces, :id, :name, { prompt: "Select Province" }, class: "form-select", required: true %>
          </div>
          <div class="col-md-3">
            <%= f.label :postal_code, class: "form-label" %>
            <%= f.text_field :postal_code, class: "form-control", required: true %>
          </div>
        </div>

        <%= f.submit "Place Order & View Tax Invoice", class: "btn btn-success btn-lg mt-4 w-100" %>
      <% end %>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card p-4 shadow-sm">
      <h4 class="mb-3">Order Summary</h4>
      <ul class="list-group mb-3">
        <% @cart_items.each do |item| %>
          <li class="list-group-item d-flex justify-content-between">
            <span><%= item[:product].title %> &times; <%= item[:quantity] %></span>
            <strong><%= number_to_currency(item[:line_total]) %></strong>
          </li>
        <% end %>
        <li class="list-group-item d-flex justify-content-between bg-light">
          <span>Subtotal (taxes calculated by province)</span>
          <strong><%= number_to_currency(@subtotal) %></strong>
        </li>
      </ul>
    </div>
  </div>
</div>