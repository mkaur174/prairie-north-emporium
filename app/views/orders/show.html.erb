<div class="card p-4 shadow-sm">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Order Tax Invoice #<%= @order.id %></h2>
    <span class="badge bg-info text-dark fs-6">Status: <%= @order.status.capitalize %></span>
  </div>

  <div class="row mb-4">
    <div class="col-md-6">
      <h5>Billed & Shipped To:</h5>
      <p class="mb-1"><strong><%= "#{@order.customer.first_name} #{@order.customer.last_name}" %></strong></p>
      <p class="mb-1"><%= @order.customer.email %></p>
      <p class="mb-0">
        <%= @order.customer.street_address %>, <%= @order.customer.city %>,
        <%= @order.customer.province.code %> <%= @order.customer.postal_code %>
      </p>
    </div>
    <div class="col-md-6 text-md-end">
      <p class="mb-1"><strong>Order Date:</strong> <%= @order.created_at.strftime("%B %d, %Y") %></p>
      <p class="mb-0"><strong>Province Tax Jurisdiction:</strong> <%= @order.customer.province.name %></p>
    </div>
  </div>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>Product</th>
        <th>Unit Price</th>
        <th>Quantity</th>
        <th class="text-end">Line Total</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_items.each do |item| %>
        <tr>
          <td><%= item.product.title %></td>
          <td><%= number_to_currency(item.price) %></td>
          <td><%= item.quantity %></td>
          <td class="text-end"><%= number_to_currency(item.price * item.quantity) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="row justify-content-end mt-3">
    <div class="col-md-5">
      <table class="table table-sm">
        <tr>
          <td>Subtotal:</td>
          <td class="text-end fw-bold"><%= number_to_currency(@order.subtotal) %></td>
        </tr>
        <% if @order.gst_amount > 0 %>
          <tr>
            <td>GST (<%= (@order.customer.province.gst * 100).round(2) %>%):</td>
            <td class="text-end"><%= number_to_currency(@order.gst_amount) %></td>
          </tr>
        <% end %>
        <% if @order.pst_amount > 0 %>
          <tr>
            <td>PST (<%= (@order.customer.province.pst * 100).round(2) %>%):</td>
            <td class="text-end"><%= number_to_currency(@order.pst_amount) %></td>
          </tr>
        <% end %>
        <% if @order.hst_amount > 0 %>
          <tr>
            <td>HST (<%= (@order.customer.province.hst * 100).round(2) %>%):</td>
            <td class="text-end"><%= number_to_currency(@order.hst_amount) %></td>
          </tr>
        <% end %>
        <tr class="table-success fs-5">
          <th>Grand Total:</th>
          <th class="text-end"><%= number_to_currency(@order.total_amount) %></th>
        </tr>
      </table>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "Continue Shopping", root_path, class: "btn btn-primary" %>
  </div>
</div>